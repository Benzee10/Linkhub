{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog-post",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[a-zA-Z0-9-]+)"
        }
      ],
      "destination": "/:id.html"
    },
    {
      "source": "/blog-post.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[a-zA-Z0-9-]+)"
        }
      ],
      "destination": "/:id.html"
    },
    {
      "source": "/post",
      "destination": "/post.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog-post",
      "destination": "/blog-post.html"
    }
  ]
}
